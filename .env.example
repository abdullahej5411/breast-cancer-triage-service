# .env.example -- a template that lists EVERY setting Docker Compose uses.
# Copy it to a file named .env and fill in your own values:
#     cp .env.example .env          (Windows PowerShell: Copy-Item .env.example .env)
# NEVER commit the real .env file. Only this example file goes to Git.

# ---- Docker Hub ----
# Your Docker Hub username (REQUIRED). Used to name the image.
DOCKERHUB_USERNAME=your-dockerhub-username
# The image tag to build or pull.
IMAGE_TAG=1.0.0

# ---- Build-time values (used by "docker compose build") ----
MODEL_VERSION=1.0.0
# Put the output of:  git rev-parse --short HEAD
GIT_SHA=replace-with-your-git-commit

# ---- Run-time values ----
# The port on YOUR computer. The container always uses 8000 inside.
HOST_PORT=8000
# A case is "malignant" when probability >= this number (0 to 1).
DECISION_THRESHOLD=0.5
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
