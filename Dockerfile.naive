# =============================================================================
# Dockerfile.naive  --  the BASELINE image (Task 10)
#
# The simplest possible Dockerfile, written on purpose WITHOUT any tricks:
#   * big Ubuntu base image
#   * Python installed with the system package manager
#   * the WHOLE project folder copied in one go
#   * training done inside the image
#   * runs as root, no multi-stage, no health check
#
# It is slow to rebuild and big. Task 11 (Dockerfile) fixes this.
# Build it with:  docker build -f Dockerfile.naive -t breast-cancer-triage-api:naive .
# =============================================================================
FROM ubuntu:22.04

# Install Python and pip with apt (the system package manager).
RUN apt-get update && apt-get install -y python3 python3-pip

WORKDIR /app

# Copy EVERYTHING. Any code change breaks the cache from here on.
COPY . .

# Install all packages (training + serving).
RUN pip3 install -r requirements-train.txt
RUN pip3 install -r requirements-serve.txt

# Train the model inside the image.
RUN python3 -m training.train --data-path data/raw/breast_cancer.csv --output-dir artifacts --model-version 1.0.0

EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
